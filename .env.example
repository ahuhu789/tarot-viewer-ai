# Alibaba Cloud DashScope API Key (for Qwen-plus LLM via OpenAI-compatible endpoint)
ALIBABA_API_KEY=your_alibaba_dashscope_api_key_here
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ElevenLabs API Key (Optional, for realistic voice readings)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional overrides
# ALIBABA_MODEL=qwen-plus
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL   # pick a native Vietnamese voice from the ElevenLabs Voice Library for best pronunciation
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5       # must support language_code "vi" (flash/turbo v2.5)

# Free alternative: Groq (OpenAI-compatible). Free tier ≈ 1000 req/day, 1000 output tokens/min.
# ALIBABA_API_KEY=your_groq_api_key
# ALIBABA_BASE_URL=https://api.groq.com/openai/v1
# ALIBABA_MODEL=qwen/qwen3.8-27b
# AI_REASONING_EFFORT=none

# Free alternative: Google Gemini via its OpenAI-compatible endpoint
# ALIBABA_API_KEY=your_gemini_api_key_from_aistudio.google.com
# ALIBABA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# ALIBABA_MODEL=gemini-flash-latest
# AI_REASONING_EFFORT=none
